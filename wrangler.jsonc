{
  // Cloudflare WORKERS (static assets) configuration.
  // Cloudflare PAGES does not use this file: it has no `pages_build_output_dir`,
  // so Pages ignores it. Pages is configured via the dashboard or CLI flags
  // (see README.md and the `deploy:pages` script).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feralui-hero",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
